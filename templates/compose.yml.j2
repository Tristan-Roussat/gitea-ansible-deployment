services:
  gitea:
    image: gitea/gitea:{{ gitea_version }}
    container_name: gitea
    restart: always
    ports:
      - "{{ gitea_port }}:3000"
    environment:
      - GITEA__server__DOMAIN={{ gitea_domain }}
      - GITEA__server__ROOT_URL={{ gitea_url }}
    volumes:
      - gitea_data:/data

volumes:
  gitea_data: