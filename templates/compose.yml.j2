services:
  gitea:
    image: gitea/gitea:{{ gitea_version }}
    container_name: gitea
    restart: always
    ports:
      - "{{ gitea_port }}:3000"
    environment:
      - GITEA__server__DOMAIN=127.0.0.1
      - GITEA__server__ROOT_URL=http://127.0.0.1:8083/
    volumes:
      - gitea_data:/data

volumes:
  gitea_data: